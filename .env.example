# Copy this file to .env and replace both values before starting the stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Prometheus metrics retention: 180 days, approximately six months.
PROMETHEUS_RETENTION_TIME=180d

# Optional absolute parent directory for all service data.
# Uses prometheus-data/, grafana-storage/, loki-data/, and alloy-data/ below this path.
# Directories are initialized automatically; changing paths does not migrate data.
# MONITORING_DATA_DIR=/data

# Optional per-service overrides, which take precedence over MONITORING_DATA_DIR.
# When both the parent and a service override are unset/empty, use its named volume.
# PROMETHEUS_DATA_DIR=/other-disk/prometheus
# GRAFANA_DATA_DIR=/other-disk/grafana
# LOKI_DATA_DIR=/other-disk/loki
# ALLOY_DATA_DIR=/other-disk/alloy

# Default: host metrics only; GPU monitoring and vLLM journal collection are disabled.
# Uncomment exactly one COMPOSE_FILE line for optional features.
# GPU metrics only:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml
# vLLM journal collection only:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.logs.yaml
# GPU metrics and vLLM journal collection:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml:docker-compose.logs.yaml
